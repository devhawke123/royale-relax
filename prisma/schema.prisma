// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  BEDS
  MATTRESSES
  FABRICS
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StockPolicy {
  TRACKED
  MADE_TO_ORDER
}

enum BedStyle {
  DIVAN
  OTTOMAN
  SLEIGH
  PANEL
  UPHOLSTERED
  WINGED
  CHESTERFIELD
}

enum MattressType {
  POCKET_SPRUNG
  MEMORY_FOAM
  PILLOW_TOP
  HYBRID
  LATEX
}

enum Firmness {
  SOFT
  MEDIUM
  MEDIUM_FIRM
  FIRM
}

enum FabricStatus {
  ACTIVE
  DISCONTINUED
}

enum AddonType {
  TOGGLE
  SELECT
  TEXT_INPUT
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum AdminRole {
  ADMIN
  MANAGER
}

enum TokenSubject {
  CUSTOMER
  ADMIN
}

model Product {
  id               String           @id @default(uuid())
  slug             String           @unique
  name             String
  shortDescription String           @default("")
  description      String           @default("")
  category         Category
  basePrice        Decimal          @db.Decimal(10, 2)
  isFeatured       Boolean          @default(false)
  isBestSeller     Boolean          @default(false)
  isNew            Boolean          @default(false)
  onSale           Boolean          @default(false)
  salePrice        Decimal?         @db.Decimal(10, 2)
  saleStartsAt     DateTime?
  saleEndsAt       DateTime?
  hasStorage       Boolean          @default(false)
  hasDrawer        Boolean          @default(false)

  // --- bed attributes (null for mattresses) ---
  bedStyle         BedStyle?
  frameMaterial    String?

  // --- mattress attributes (null for beds) ---
  mattressType     MattressType?
  firmness         Firmness?
  depthCm          Int?

  // --- fulfilment ---
  stockPolicy      StockPolicy      @default(MADE_TO_ORDER)
  leadTimeDays     Int?
  warrantyMonths   Int?
  careInstructions String?
  specSheetUrl     String?

  // --- denormalised review aggregates ---
  ratingAvg        Decimal?         @db.Decimal(3, 2)
  reviewCount      Int              @default(0)

  // --- SEO ---
  metaTitle        String?
  metaDescription  String?

  status           ProductStatus    @default(DRAFT)
  sortOrder        Int              @default(0)
  publishedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  images           ProductImage[]
  sizes            ProductSize[]
  addons           ProductAddon[]
  orderItems       OrderItem[]
  fabricColors     FabricColor[]
  bedOfTheWeekEntries BedOfTheWeek[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  path      String
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSize {
  id            String  @id @default(uuid())
  productId     String
  label         String
  priceModifier Decimal @default(0) @db.Decimal(10, 2)
  priceOverride Decimal? @db.Decimal(10, 2)
  sku           String? @unique
  stockQty      Int?
  isAvailable   Boolean @default(true)
  leadTimeDays  Int?
  widthCm       Int?
  lengthCm      Int?
  heightCm      Int?
  sortOrder     Int     @default(0)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([productId])
}

model ProductAddon {
  id         String               @id @default(uuid())
  productId  String
  name       String
  type       AddonType
  /// TOGGLE: surcharge applied when the customer picks "Yes". SELECT/TEXT_INPUT: unused (kept 0).
  price      Decimal              @default(0) @db.Decimal(10, 2)
  /// TOGGLE only: surcharge applied when the customer picks "No" (usually 0, but admins can price it too).
  noPrice    Decimal              @default(0) @db.Decimal(10, 2)
  isRequired Boolean              @default(false)
  sortOrder  Int                  @default(0)
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    ProductAddonOption[]

  @@index([productId])
}

model ProductAddonOption {
  id            String       @id @default(uuid())
  addonId       String
  label         String
  priceModifier Decimal      @default(0) @db.Decimal(10, 2)
  sortOrder     Int          @default(0)
  addon         ProductAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@index([addonId])
}

model FabricColor {
  id          String       @id @default(uuid())
  productId   String
  code        String       @unique
  colorName   String
  imagePath   String
  description String       @default("")
  stockQty    Int          @default(0)
  status      FabricStatus @default(ACTIVE)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([productId])
}

/// A scheduled homepage promotion for a single product. Only one row may be
/// `isActive: true` at a time — creating a new one flips the previous active
/// row to inactive (see lib/bed-of-the-week.ts). Inactive rows form the
/// "Previous Beds of the Week" history and are never deleted.
model BedOfTheWeek {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPercentage Decimal  @db.Decimal(5, 2)
  validFrom          DateTime @default(now())
  validUntil         DateTime
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([productId])
  @@index([isActive])
  @@index([validFrom])
}

model Order {
  id                         String        @id @default(uuid())
  orderNumber                String        @unique
  /// Null = guest checkout. Guests are first-class, not a degraded path.
  customerId                 String?
  customer                   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status                     OrderStatus   @default(PENDING)
  paymentStatus              PaymentStatus @default(UNPAID)
  firstName                  String
  lastName                   String
  companyName                String?
  country                    String
  address                    String
  city                       String
  county                     String
  postcode                   String
  phone                      String
  email                      String
  deliverToDifferentAddress  Boolean       @default(false)
  orderNotes                 String?
  subtotal                   Decimal       @db.Decimal(10, 2)
  shippingFee                Decimal       @db.Decimal(10, 2)
  total                      Decimal       @db.Decimal(10, 2)

  paymentProvider            String?       @default("stripe")
  /// The Stripe Checkout Session id — created before redirect, this is what
  /// you look the order up by when the webhook fires.
  stripeCheckoutSessionId    String?       @unique
  /// Populated from the webhook payload once the session completes. Only the
  /// webhook handler may set this / flip paymentStatus to PAID.
  stripePaymentIntentId      String?
  paidAt                     DateTime?

  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @default(now()) @updatedAt
  items                      OrderItem[]

  @@index([customerId])
  @@index([status, createdAt])
  @@index([email])
}

model OrderItem {
  id            String           @id @default(uuid())
  orderId       String
  productId     String? // SetNull so deleting a product never destroys order history
  sizeId        String?
  /// The colourway chosen — the bed's upholstery, or the swatch being bought.
  fabricColorId String?

  // --- immutable snapshot: what the customer actually bought, at that price ---
  productName   String
  productSlug   String?
  categoryLabel String?
  sizeLabel     String?
  fabricCode    String?
  fabricName    String?
  sku           String?
  imagePath     String?
  unitPrice     Decimal          @db.Decimal(10, 2)
  quantity      Int
  lineTotal     Decimal          @db.Decimal(10, 2)

  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  size          ProductSize?     @relation(fields: [sizeId], references: [id], onDelete: SetNull)
  fabricColor   FabricColor?     @relation(fields: [fabricColorId], references: [id], onDelete: SetNull)
  addons        OrderItemAddon[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemAddon {
  id             String    @id @default(uuid())
  orderItemId    String
  addonName      String
  selectedLabel  String?
  textValue      String?
  priceAtOrder   Decimal   @db.Decimal(10, 2)
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

// =============================================================================
// CUSTOMERS, AUTH & PAYMENTS
// =============================================================================

model Customer {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  orders        Order[]
  refreshTokens RefreshToken[]

  @@index([email])
}

model AdminUser {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          AdminRole      @default(ADMIN)
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  refreshTokens RefreshToken[]
}

/// Backs JWT auth for BOTH customers and admins. Access tokens are short-lived
/// and stateless (never touch the DB); this table exists purely so a refresh
/// token can be revoked — on logout, password change, or a suspected leak.
/// Exactly one of customerId/adminUserId is set, matching subject.
model RefreshToken {
  id           String        @id @default(uuid())
  /// SHA-256 of the actual token. The raw token is never stored — this table
  /// leaking is not equivalent to every session leaking.
  tokenHash    String        @unique
  subject      TokenSubject
  customerId   String?
  adminUserId  String?
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Set when this token was exchanged for a new one, pointing at its
  /// replacement. A token used twice after rotation is theft, not a race.
  replacedById String?
  userAgent    String?
  createdAt    DateTime      @default(now())

  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  adminUser    AdminUser?    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([adminUserId])
  @@index([expiresAt])
}

/// Every Stripe webhook event id we've successfully processed. Stripe retries
/// on anything but a 200, so the same event WILL arrive more than once —
/// this is what stops a retried webhook double-fulfilling an order.
model StripeWebhookEvent {
  id          String   @id // the Stripe event id ("evt_...") — the dedupe key
  type        String
  processedAt DateTime @default(now())
}

/// Singleton row (id always "default") backing the admin Settings page.
model StoreSettings {
  id        String   @id @default("default")
  storeName String
  email     String
  phone     String
  updatedAt DateTime @default(now()) @updatedAt
}
