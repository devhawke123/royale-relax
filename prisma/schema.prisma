// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  BEDS
  MATTRESSES
  FABRICS
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum AddonType {
  TOGGLE
  SELECT
  TEXT_INPUT
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model Product {
  id           String         @id @default(uuid())
  slug         String         @unique
  name         String
  description  String         @default("")
  category     Category
  basePrice    Decimal        @db.Decimal(10, 2)
  isFeatured   Boolean        @default(false)
  isBestSeller Boolean        @default(false)
  isNew        Boolean        @default(false)
  onSale       Boolean        @default(false)
  salePrice    Decimal?       @db.Decimal(10, 2)
  hasStorage   Boolean        @default(false)
  hasDrawer    Boolean        @default(false)
  status       ProductStatus  @default(DRAFT)
  createdAt    DateTime       @default(now())
  colors       ProductColor[]
  sizes        ProductSize[]
  variants     ProductVariant[]
  addons       ProductAddon[]
  orderItems   OrderItem[]
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  price     Decimal  @default(0) @db.Decimal(10, 2)
  sku       String?
  inStock   Boolean  @default(true)

  @@unique([productId, size])
}

model ProductColor {
  id            String         @id @default(uuid())
  productId     String
  name          String
  code          String?
  isDefault     Boolean        @default(false)
  priceModifier Decimal        @default(0) @db.Decimal(10, 2)
  sortOrder     Int            @default(0)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images        ProductImage[]

  @@index([productId])
}

model ProductImage {
  id             String       @id @default(uuid())
  productColorId String
  path           String
  isMain         Boolean      @default(false)
  sortOrder      Int          @default(0)
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)

  @@index([productColorId])
}

model ProductSize {
  id            String  @id @default(uuid())
  productId     String
  label         String
  priceModifier Decimal @default(0) @db.Decimal(10, 2)
  stockQty      Int?
  sortOrder     Int     @default(0)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductAddon {
  id         String               @id @default(uuid())
  productId  String
  name       String
  type       AddonType
  price      Decimal              @default(0) @db.Decimal(10, 2)
  isRequired Boolean              @default(false)
  sortOrder  Int                  @default(0)
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    ProductAddonOption[]

  @@index([productId])
}

model ProductAddonOption {
  id            String       @id @default(uuid())
  addonId       String
  label         String
  priceModifier Decimal      @default(0) @db.Decimal(10, 2)
  sortOrder     Int          @default(0)
  addon         ProductAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@index([addonId])
}

model Fabric {
  id        String        @id @default(uuid())
  slug      String        @unique
  name      String        @unique
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  colors    FabricColor[]
}

model FabricColor {
  id        String   @id @default(uuid())
  fabricId  String
  code      String   @unique
  colorName String
  imagePath String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  fabric    Fabric   @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  @@index([fabricId])
}

model Order {
  id                         String      @id @default(uuid())
  orderNumber                String      @unique
  status                     OrderStatus @default(PENDING)
  firstName                  String
  lastName                   String
  companyName                String?
  country                    String
  address                    String
  city                       String
  county                     String
  postcode                   String
  phone                      String
  email                      String
  deliverToDifferentAddress  Boolean     @default(false)
  orderNotes                 String?
  subtotal                   Decimal     @db.Decimal(10, 2)
  shippingFee                Decimal     @db.Decimal(10, 2)
  total                      Decimal     @db.Decimal(10, 2)
  createdAt                  DateTime    @default(now())
  items                      OrderItem[]
}

model OrderItem {
  id          String           @id @default(uuid())
  orderId     String
  productId   String
  productName String
  colorName   String?
  sizeLabel   String?
  unitPrice   Decimal          @db.Decimal(10, 2)
  quantity    Int
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  addons      OrderItemAddon[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemAddon {
  id             String    @id @default(uuid())
  orderItemId    String
  addonName      String
  selectedLabel  String?
  textValue      String?
  priceAtOrder   Decimal   @db.Decimal(10, 2)
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}
