// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  BEDS
  MATTRESSES
  FABRICS
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StockPolicy {
  TRACKED
  MADE_TO_ORDER
}

enum BedStyle {
  DIVAN
  OTTOMAN
  SLEIGH
  PANEL
  UPHOLSTERED
  WINGED
  CHESTERFIELD
}

enum MattressType {
  POCKET_SPRUNG
  MEMORY_FOAM
  PILLOW_TOP
  HYBRID
  LATEX
}

enum Firmness {
  SOFT
  MEDIUM
  MEDIUM_FIRM
  FIRM
}

enum FabricStatus {
  ACTIVE
  DISCONTINUED
}

enum AddonType {
  TOGGLE
  SELECT
  TEXT_INPUT
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model Product {
  id               String           @id @default(uuid())
  slug             String           @unique
  name             String
  shortDescription String           @default("")
  description      String           @default("")
  category         Category
  basePrice        Decimal          @db.Decimal(10, 2)
  isFeatured       Boolean          @default(false)
  isBestSeller     Boolean          @default(false)
  isNew            Boolean          @default(false)
  onSale           Boolean          @default(false)
  salePrice        Decimal?         @db.Decimal(10, 2)
  saleStartsAt     DateTime?
  saleEndsAt       DateTime?
  hasStorage       Boolean          @default(false)
  hasDrawer        Boolean          @default(false)

  // --- bed attributes (null for mattresses) ---
  bedStyle         BedStyle?
  frameMaterial    String?

  // --- mattress attributes (null for beds) ---
  mattressType     MattressType?
  firmness         Firmness?
  depthCm          Int?

  // --- fulfilment ---
  stockPolicy      StockPolicy      @default(MADE_TO_ORDER)
  leadTimeDays     Int?
  warrantyMonths   Int?
  careInstructions String?
  specSheetUrl     String?

  // --- denormalised review aggregates ---
  ratingAvg        Decimal?         @db.Decimal(3, 2)
  reviewCount      Int              @default(0)

  // --- SEO ---
  metaTitle        String?
  metaDescription  String?

  status           ProductStatus    @default(DRAFT)
  sortOrder        Int              @default(0)
  publishedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  images           ProductImage[]
  sizes            ProductSize[]
  addons           ProductAddon[]
  orderItems       OrderItem[]
  fabricColors     FabricColor[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  path      String
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSize {
  id            String  @id @default(uuid())
  productId     String
  label         String
  priceModifier Decimal @default(0) @db.Decimal(10, 2)
  priceOverride Decimal? @db.Decimal(10, 2)
  sku           String? @unique
  stockQty      Int?
  isAvailable   Boolean @default(true)
  leadTimeDays  Int?
  widthCm       Int?
  lengthCm      Int?
  heightCm      Int?
  sortOrder     Int     @default(0)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductAddon {
  id         String               @id @default(uuid())
  productId  String
  name       String
  type       AddonType
  price      Decimal              @default(0) @db.Decimal(10, 2)
  isRequired Boolean              @default(false)
  sortOrder  Int                  @default(0)
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    ProductAddonOption[]

  @@index([productId])
}

model ProductAddonOption {
  id            String       @id @default(uuid())
  addonId       String
  label         String
  priceModifier Decimal      @default(0) @db.Decimal(10, 2)
  sortOrder     Int          @default(0)
  addon         ProductAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@index([addonId])
}

model FabricColor {
  id          String       @id @default(uuid())
  productId   String
  code        String       @unique
  colorName   String
  imagePath   String
  description String       @default("")
  stockQty    Int          @default(0)
  status      FabricStatus @default(ACTIVE)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                         String      @id @default(uuid())
  orderNumber                String      @unique
  status                     OrderStatus @default(PENDING)
  firstName                  String
  lastName                   String
  companyName                String?
  country                    String
  address                    String
  city                       String
  county                     String
  postcode                   String
  phone                      String
  email                      String
  deliverToDifferentAddress  Boolean     @default(false)
  orderNotes                 String?
  subtotal                   Decimal     @db.Decimal(10, 2)
  shippingFee                Decimal     @db.Decimal(10, 2)
  total                      Decimal     @db.Decimal(10, 2)
  createdAt                  DateTime    @default(now())
  items                      OrderItem[]
}

model OrderItem {
  id          String           @id @default(uuid())
  orderId     String
  productId   String
  productName String
  colorName   String?
  sizeLabel   String?
  unitPrice   Decimal          @db.Decimal(10, 2)
  quantity    Int
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  addons      OrderItemAddon[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemAddon {
  id             String    @id @default(uuid())
  orderItemId    String
  addonName      String
  selectedLabel  String?
  textValue      String?
  priceAtOrder   Decimal   @db.Decimal(10, 2)
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}
